{
    "name": "cartoonclouds/whatsthatabout",
    "type": "project",
    "description": "Ever watched a movie or TV episode and didn't get that joke? What was that reference about? Find the answer here!",
    "keywords": [
        "movie",
        "film",
        "episode",
        "TV",
        "reference"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "CJ Tudhope",
            "email": "cartoonclouds@gmail.com",
            "homepage": "https://github.com/cartoonclouds/"
        }
    ],
    "require": {
        "php": "^7.3",
        "algolia/scout-extended": "^1.9",
        "chitranu/google-recaptcha": "^1.2",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "guzzlehttp/guzzle": "6.4.1",
        "intervention/image": "^2.5",
        "laracasts/flash": "^3.1",
        "laravel/framework": "^7.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.0",
        "league/flysystem-aws-s3-v3": "^1.0",
        "league/flysystem-cached-adapter": "^1.0",
        "sentry/sentry-laravel": "^1.7",
        "spatie/laravel-permission": "^3.11",
        "spatie/laravel-sluggable": "^2.2",
        "yajra/laravel-datatables-oracle": "^9.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "barryvdh/laravel-ide-helper": "^2.6",
        "doctrine/dbal": "^2.10",
        "facade/ignition": "^2.0",
        "filp/whoops": "^2.7",
        "fzaninotto/faker": "^1.9.1",
        "kitloong/laravel-migrations-generator": "^4.3",
        "laracasts/generators": "^1.1",
        "laracasts/testdummy": "^2.4",
        "laravel/browser-kit-testing": "^6.0",
        "laravel/dusk": "^5.11",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.3"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar",
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/Http/Controllers",
            "app/Classes",
            "app/Models"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "classmap": [
            "database/seeds",
            "database/factories",
            "tests/factories"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize",
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan ide-helper:models --dir='app\\Models'"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}

<?xml version="1.0"?>
<ruleset name="WTA Ruleset">
    <description>WTA PHP CodeSniffer Ruleset</description>
    <file>app/</file>

    <!-- args -->
    <arg name="colors"/>
    <arg name="standard" value="PSR1,PSR12"/>

    <!-- config -->
    <config name="php_path" value="/usr/bin/php"/>

    <exclude-pattern>vendor</exclude-pattern>

    <rule ref="PSR1"/>
    <rule ref="PSR12">
        <exclude name="PSR12.Classes.ClassInstantiation"/>
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>

<?xml version="1.0"?>
<ruleset name="WTA Ruleset">
    <description>WTA PHP CodeSniffer Ruleset</description>
    <file>app/</file>

    <!-- args -->
    <arg name="colors"/>
    <arg name="standard" value="PEAR,PSR1,PSR12,PSR2"/>

    <!-- config -->
    <config name="php_path" value="/usr/bin/php"/>

    <exclude-pattern>vendor</exclude-pattern>

<!--    <rule ref="PEAR"/>-->
    <rule ref="PSR1"/>
<!--    <rule ref="PSR12"/>-->
    <rule ref="PSR12">
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR2.Methods.MethodDeclaration"/>
    </rule>
</ruleset>

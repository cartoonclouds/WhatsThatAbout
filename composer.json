{
    "name": "cartoonclouds/whatsthatabout",
    "type": "project",
    "description": "Ever watched a movie or TV episode and didn't get that joke? What was that reference about? Find the answer here!",
    "keywords": [
        "movie",
        "film",
        "episode",
        "TV",
        "reference"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "CJ Tudhope",
            "email": "cartoonclouds@gmail.com",
            "homepage": "https://github.com/cartoonclouds/"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "cviebrock/eloquent-sluggable": "^8.0",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laracasts/flash": "^3.2",
        "laravel/fortify": "^1.6",
        "laravel/framework": "^8.12",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.1",
        "league/flysystem-aws-s3-v3": "^1.0",
        "league/flysystem-cached-adapter": "^1.1",
        "sentry/sentry-laravel": "^2.2",
        "spatie/laravel-activitylog": "^3.16",
        "spatie/laravel-permission": "^3.17",
        "yajra/laravel-datatables": "^1.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "barryvdh/laravel-ide-helper": "^2.8",
        "facade/ignition": "^2.3.6",
        "fakerphp/faker": "^1.10.1",
        "kitloong/laravel-migrations-generator": "^4.4",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3",
        "squizlabs/php_codesniffer": "*",
        "sven/artisan-view": "^3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@ide-helper"
        ],
        "ide-helper": [
            "php artisan clear-compiled",
            "php artisan optimize",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models -N"
        ]
    }
}
